<Window x:Class="Toolkit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolkit V5.1 — Desktop" Width="1500" Height="900" MinWidth="1000" MinHeight="680"
        Icon="/Toolkit.Desktop;component/Assets/Toolkit_Amber_Thin_Rounded_Glow.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="Surface" Margin="18,14,18,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="C:\TOOLKIT" FontFamily="Consolas" FontSize="34" Foreground="{StaticResource MintBrush}" />
        <TextBlock Text="TOOLKIT V5.1   ·   WINDOWS 11 DESKTOP" Style="{StaticResource Label}" Margin="2,5,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RotateLayoutButton" Content="ROTATE LAYOUT" Click="RotateLayout_Click" IsEnabled="{Binding HistoryEnabled}" Margin="0,0,18,0"
                FontFamily="Consolas" FontSize="12" ToolTip="Switch between left/right and top/bottom panel arrangements." />
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#10251B" BorderBrush="#286246" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Right">
            <TextBlock Text="{Binding AdministratorLabel}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MintBrush}" />
          </Border>
          <TextBlock Text="{Binding CatalogSummary}" Style="{StaticResource Label}" Margin="0,8,0,0" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Panel}" BorderBrush="#286246" Padding="16,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="C:\TOOLKIT&gt;" FontFamily="Consolas" FontSize="19" Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Grid Grid.Column="1">
          <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="18" Background="Transparent" BorderThickness="0" Padding="2,5" VerticalContentAlignment="Center" AutomationProperties.Name="Search all commands by name or ID" KeyDown="SearchBox_KeyDown" />
          <TextBlock Text="Search by name or ID…" IsHitTestVisible="False" Foreground="#AFC5B9" FontFamily="Consolas" FontSize="18" Margin="4,5">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Button Grid.Column="2" Content="ESC  CLEAR" Command="{Binding ClearSearchCommand}" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" ToolTip="Clear search. Ctrl+F focuses search." />
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#2B2213" BorderBrush="#715729" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Notice}" Foreground="#E6C783" TextWrapping="Wrap" />
    </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>

      <Border x:Name="MainPanel" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
              <TextBlock Text="TOOLKIT DESKTOP" Style="{StaticResource Label}" />
              <TextBlock Text="231 actions · select a category, then choose a command" Style="{StaticResource Label}" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="145" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" CornerRadius="0" BorderThickness="0,0,1,0">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                  <TextBlock Text="CATEGORIES" Style="{StaticResource Label}" />
                </Border>
                <ListBox x:Name="CategoryList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" Padding="0,6" AutomationProperties.Name="Command categories">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid ToolTip="{Binding Hint}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Count}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />
            <Border Grid.Column="2" Style="{StaticResource Panel}" CornerRadius="0" BorderThickness="0">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                  <Grid><TextBlock Text="COMMAND CATALOG" Style="{StaticResource Label}" /><TextBlock Text="{Binding MatchLabel}" Style="{StaticResource Label}" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Right" /></Grid>
                </Border>
                <Grid>
                  <ListBox x:Name="CommandList" ItemsSource="{Binding VisibleTools}" SelectedItem="{Binding SelectedTool}" Padding="0,6" AutomationProperties.Name="Commands">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid ToolTip="{Binding DisplayTitle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="18" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayTitle}" FontSize="15" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Risk}" FontFamily="Consolas" FontSize="12" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text=" / " FontSize="12" Foreground="#8FA99B" Margin="5,0" />
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="12">
                              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Foreground" Value="{StaticResource MintBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="No commands match this search." Margin="20" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="{Binding NoMatches, Converter={StaticResource BoolVisibility}}" />
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Resize the main and right panels." />

      <Grid x:Name="SidePanels" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" MinHeight="180" />
          <RowDefinition Height="8" />
          <RowDefinition x:Name="OutputRow" Height="0.8*" MinHeight="220" />
        </Grid.RowDefinitions>
        <Border x:Name="DetailsPanel" Style="{StaticResource Panel}">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
              <Grid><TextBlock Text="COMMAND RUNNER / TERMINAL" Style="{StaticResource Label}" /><TextBlock Text="{Binding SelectedTool.Risk}" FontFamily="Consolas" FontSize="12" Foreground="{Binding SelectedTool.Risk, Converter={StaticResource StatusBrush}}" HorizontalAlignment="Right" /></Grid>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,14">
              <TextBlock Text="{Binding SelectedTool.RunNote}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding SelectedTool.ShowRunNote, Converter={StaticResource BoolVisibility}}" />
              <Button x:Name="RunButton" Content="{Binding RunLabel}" Command="{Binding RunCommand}" Background="#174832" BorderBrush="#3A9469" Foreground="{StaticResource MintBrush}" FontSize="14" FontWeight="SemiBold" Padding="14,10" AutomationProperties.Name="Run selected command" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16,12,16,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding SelectedTool.Id}" FontFamily="Consolas" FontSize="32" Foreground="{StaticResource AmberBrush}" />
                <TextBlock Text="{Binding SelectedTool.DisplayTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,5" />
                <TextBlock Text="{Binding SelectedTool.CategoryName}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedTool.Description}" TextWrapping="Wrap" LineHeight="21" Foreground="#D0DED6" FontSize="14" />
                <Grid Margin="0,12,0,6">
                  <TextBlock Text="COMMAND PREVIEW" Style="{StaticResource Label}" VerticalAlignment="Center" />
                  <Button Content="COPY" Command="{Binding CopyCommand}" HorizontalAlignment="Right" Padding="10,5" FontFamily="Consolas" FontSize="12" ToolTip="Copy the existing action's code. This does not run it." />
                </Grid>
                <TextBox Text="{Binding SelectedTool.Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="110" Padding="10" AutomationProperties.Name="Existing command preview" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter x:Name="SideSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Resize the runner and lower panel." />

        <Border x:Name="OutputPanel" Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <TabControl SelectedIndex="{Binding OutputTab}">
              <TabItem Header="OUTPUT">
                <Grid Margin="10,8">
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBox x:Name="OutputBox" Text="{Binding SelectedRun.Output, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="2" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OutputBox_TextChanged" AutomationProperties.Name="Command output" Visibility="{Binding HasRun, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding EmptyOutput}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding HasRun, Converter={StaticResource InverseVisibility}}" />
                  <Border Grid.Row="1" BorderBrush="#286246" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasPrompt, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                      <TextBlock Text="{Binding Prompt}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MintBrush}" Margin="0,0,0,6" />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Send answer" Command="{Binding SendAnswerCommand}" Margin="8,0,0,0" Padding="12,5" />
                        <TextBox x:Name="AnswerBox" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" MaxLength="16000" FontFamily="Consolas" FontSize="14" Padding="8" KeyDown="AnswerBox_KeyDown" AutomationProperties.Name="Answer the Toolkit question" ToolTip="Your answer goes to the existing Toolkit question. Leave blank and send to submit Enter." />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0">
                    <Button Content="Open TXT" Command="{Binding OpenTextCommand}" Padding="8,4" FontSize="11" Margin="0,0,5,0" />
                    <Button Content="Open JSON" Command="{Binding OpenJsonCommand}" Padding="8,4" FontSize="11" />
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="REPAIR KIT">
                <DockPanel Margin="10,8">
                  <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="CATEGORY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="RepairKitCategoryList" Grid.Column="1" ItemsSource="{Binding RepairCategories}" SelectedItem="{Binding SelectedRepairCategory}" AutomationProperties.Name="Repair Kit categories">
                      <ComboBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Grid.Column="1" Text="{Binding Count}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                        </Grid>
                      </DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <ListBox x:Name="RepairKitList" ItemsSource="{Binding VisibleRepairTools}" SelectedItem="{Binding SelectedTool}" AutomationProperties.Name="Repair Kit actions">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayTitle}" FontSize="14" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Risk}" FontFamily="Consolas" FontSize="11" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
              <TabItem Header="FINDINGS">
                <DockPanel Margin="12,8">
                  <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedRun.Summary, TargetNullValue='Run a guided workflow or 175 to see diagnostic findings.'}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                  <ListBox ItemsSource="{Binding SelectedRun.Findings}" AutomationProperties.Name="Diagnostic findings">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontFamily="Consolas" FontSize="12" />
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Check}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" Margin="0,3" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
              <TabItem Header="HISTORY">
                <DockPanel Margin="10,8">
                  <TextBlock DockPanel.Dock="Top" Text="This session only · select a run, then open Output or Findings" Style="{StaticResource Label}" Margin="4,0,0,6" />
                  <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRun}" IsEnabled="{Binding HistoryEnabled}" AutomationProperties.Name="Run history">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource MintBrush}" FontSize="12" />
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="4" Margin="1,7,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding Status}" Style="{StaticResource Label}" VerticalAlignment="Center" /></StackPanel>
      <Button Grid.Column="1" Content="Stop check" Command="{Binding StopCommand}" Padding="10,3" FontSize="12" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</Window>
